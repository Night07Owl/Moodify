# MoodMusic Environment Configuration Example
# Copy this file to .env and fill in your keys: cp .env.example .env

# Django Secret Key (Generate a secure key for production)
SECRET_KEY=django-insecure-your-secret-key-here-for-moodmusic-assessment

# Django Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# MongoDB Connection URI (Optional: If empty or unreachable, MoodMusic gracefully falls back to mongomock)
MONGODB_URI=mongodb://127.0.0.1:27017/moodmusic_db
MONGODB_NAME=moodmusic_db
